{
  "name": "hiya-coffee",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "install:all": "npm install --include=dev && npm install --include=dev --prefix hiya-admin",
    "dev": "concurrently --names site,admin --prefix-colors green,yellow --kill-others-on-fail \"vite\" \"npm run dev --prefix hiya-admin\"",
    "dev:site": "vite",
    "dev:admin": "npm run dev --prefix hiya-admin",
    "build": "vite build && npm run build --prefix hiya-admin && node scripts/copy-admin.mjs",
    "preview": "vite preview",
    "preview:dist": "node scripts/preview-dist.mjs",
    "start": "serve -s dist -l $PORT"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serve": "^14.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
